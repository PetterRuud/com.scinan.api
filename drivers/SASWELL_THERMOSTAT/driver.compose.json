{
  "name": {
    "en": "V2 Saswell (\"Thermostat\" App)",
    "no": "V2 Saswell (\"Thermostat\" App)"
  },
  "images": {
    "small": "drivers/SASWELL_THERMOSTAT/assets/images/small.jpg",
    "large": "drivers/SASWELL_THERMOSTAT/assets/images/large.jpg"
  },
  "repair": [
    {
      "id": "start",
      "template": "login_credentials",
      "options": {
        "logo": "pair_logo.svg",
        "usernameLabel": "Saswell Thermostat account",
        "usernamePlaceholder": "user@domain.com",
        "passwordLabel": "Password",
        "passwordPlaceholder": "Password"
      }
    }
  ],
  "class": "thermostat",
  "capabilities": [
    "onoff",
    "mode",
    "target_temperature",
    "measure_temperature",
    "away",
    "measure_power"
  ],
  "capabilitiesOptions": {
    "measure_power": {
      "approximated": true
    }
  },
  "pair": [
    {
      "id": "loading",
      "template": "loading"
    },
    {
      "id": "start",
      "template": "login_credentials",
      "navigation": {
        "next": "list_my_devices"
      },
      "options": {
        "logo": "pair_logo.svg",
        "usernameLabel": "Saswell Thermostat account",
        "usernamePlaceholder": "user@domain.com",
        "passwordLabel": "Password",
        "passwordPlaceholder": "Password"
      }
    },
    {
      "id": "list_my_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_my_devices",
        "prev": "start"
      }
    },
    {
      "id": "add_my_devices",
      "template": "add_devices"
    }
  ],
  "settings": [
    {
      "type": "group",
      "label": {
        "en": "Local network",
        "no": "Lokalt nettverk"
      },
      "children": [
        {
          "id": "localEnabled",
          "type": "checkbox",
          "label": {
            "en": "Use local network",
            "no": "Bruk lokalt nettverk"
          },
          "hint": {
            "en": "Use a direct connection for a supported thermostat, with Saswell cloud as a backup.",
            "no": "Koble direkte til en støttet termostat, med Saswell-skyen som reserve."
          },
          "value": false,
          "highlight": true
        },
        {
          "id": "localIp",
          "type": "text",
          "label": {
            "en": "Thermostat IP address",
            "no": "Termostatens IP-adresse"
          },
          "hint": {
            "en": "Leave blank for discovery, or enter the thermostat's local IPv4 address.",
            "no": "La feltet stå tomt for automatisk søk, eller skriv inn termostatens lokale IPv4-adresse."
          },
          "value": ""
        },
        {
          "id": "localStatus",
          "type": "label",
          "label": {
            "en": "Connection status",
            "no": "Tilkoblingsstatus"
          },
          "value": ""
        }
      ]
    },
    {
      "type": "group",
      "label": {
        "en": "Update device time",
        "no": "Oppdater intervall for henting av data"
      },
      "children": [
        {
          "id": "interval",
          "type": "label",
          "label": {
            "en": "this setting is moved to app settings",
            "no": "denne instillingen er flyttet til app innstillinger"
          },
          "value": "n/a"
        }
      ]
    },
    {
      "type": "group",
      "label": {
        "en": "On/off functionality",
        "no": "Av/på-funksjonalitet"
      },
      "children": [
        {
          "id": "onOffCapability",
          "type": "checkbox",
          "label": {
            "en": "On/off reflects opposite state of away mode",
            "no": "Av/på reflekterer motsatt tilstand av borte modus"
          },
          "value": false
        }
      ]
    },

    {
      "type": "group",
      "label": {
        "en": "square meters of the heating floor",
        "no": "Hvor mange kvadradmeter varmefolie"
      },
      "children": [
        {
          "id": "m2",
          "type": "number",
          "label": {
            "en": "m2",
            "no": "m2"
          },
          "value": 1,
          "min": 1,
          "max": 99
        }
      ]
    },
    {
      "type": "group",
      "label": {
        "en": "Device Information",
        "no": "Enhetinformasjon"
      },
      "children": [
        {
          "id": "apiVersion",
          "type": "label",
          "label": {
            "en": "API Version",
            "no": "API-versjon"
          },
          "value": "2"
        }
      ]
    }
  ]
}
